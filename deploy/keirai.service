# Keirai systemd service - keeps the bot alive and starts it on boot.
#
# !! THIS IS A TEMPLATE - IT DOES NOT WORK IF COPIED AS-IS !!
# The paths below are placeholders. Install = EDIT FIRST, then copy:
#
#   1. Edit User= and the three /home/youruser paths below.
#      (config for the repo is config.toml, not config.json - TOML since the
#      stdlib tomllib switch; create it in the repo dir before starting.)
#   2. sudo cp deploy/keirai.service /etc/systemd/system/keirai.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now keirai
#
# WHY THIS MATTERS: copying an unedited copy into /etc/systemd/system/ makes
# every start fail with 217/USER (the placeholder User= does not resolve),
# while the *already-running* process keeps working - so nothing looks wrong
# until the next restart, when the bot cannot come back up. This happened.
# Diff the two files before every copy; if /etc/systemd/system/ was fixed by
# hand in an emergency, copy it BACK here so the repo stays true.
#
# NOTE: do not use %h here - older systemd (e.g. Oracle Linux, systemd 239)
# expands it to /root in system units, which breaks CHDIR.
#
# Useful commands:
#   systemctl status keirai          # is it running?
#   journalctl -u keirai -f          # live logs
#   sudo systemctl restart keirai    # after code/config changes
#   sudo systemctl disable keirai    # remove autostart

[Unit]
Description=Keirai Telegram AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# run as a normal user, not root - change to your username
User=youruser
WorkingDirectory=/home/youruser/keirai
ExecStart=/usr/bin/python3 /home/youruser/keirai/main.py
# keep alive: restart on crash, on exit, on kill
Restart=always
RestartSec=3
# hard memory cap - protects the potato (cap, not reservation; idle usage ~20MB)
MemoryMax=512M
# stop Python from buffering stdout (live logs in journalctl)
Environment=PYTHONUNBUFFERED=1
# last will: runs AFTER the process is gone and reports the death in the chat
# ($SERVICE_RESULT says why). deploy/notify_stop.py - silent on clean stops,
# rate-limited so a crash loop pings once.
ExecStopPost=/usr/bin/python3 /home/youruser/keirai/deploy/notify_stop.py
# welcome back: runs at start but WAITS for readiness (unit active, PID alive,
# Telegram getMe answering), then says so in the chat - "restarted" should be
# confirmed, not assumed. Detaches, so systemd does not wait. Silent when it
# cannot confirm, and rate-limited so a crash loop announces once.
# deploy/notify_start.py
ExecStartPost=/usr/bin/python3 /home/youruser/keirai/deploy/notify_start.py --detach

[Install]
WantedBy=multi-user.target
